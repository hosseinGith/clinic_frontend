# MedFlow Aesthetic Clinic Operations Panel - Environment Variables

# Data source mode: 'mock' (local storage + seed simulation) or 'http' (REST backend API)
VITE_DATA_SOURCE=http

# Base URL for backend REST API (when VITE_DATA_SOURCE=http)
# Example local backend development URL:
VITE_API_BASE_URL=/api/v1

# Captcha Provider: 'mock' | 'turnstile'
VITE_CAPTCHA_PROVIDER=mock

# Cloudflare Turnstile Public Site Key (client-side safe)
# IMPORTANT: Never expose TURNSTILE_SECRET in frontend; only public site key belongs here.
VITE_TURNSTILE_SITE_KEY=

# SMS Provider implementation: 'mock' | 'kavenegar' | 'melipayamak'
VITE_SMS_PROVIDER=mock

# Payment Gateway implementation: 'mock' | 'zarinpal' | 'idpay'
VITE_PAYMENT_PROVIDER=mock
